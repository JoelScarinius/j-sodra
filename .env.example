# J-Södra Analytics - example environment file
# ------------------------------------------------------------
# Copy this file to `.env` for local development:
#
#   cp .env.example .env
#
# Then replace placeholder values with real secrets.
# Never commit `.env` with real secrets.

# ============================================================
# 1. Supabase Edge Function / Wyscout proxy access
# ============================================================
# The Python pipeline calls this Supabase Edge Function instead of calling
# Wyscout directly. Usually this should point to the wyscout-proxy function.
SUPABASE_FUNCTION_URL=https://<project-ref>.supabase.co/functions/v1/wyscout-proxy

# Supabase anon key or service role key used to call the Edge Function.
# For local development, use the anon key if the function allows it.
# For trusted server-side jobs, a service role key may be used carefully.
SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# HTTP timeout for API calls, in seconds.
HTTP_TIMEOUT_SECONDS=30


# ============================================================
# 2. Wyscout credentials for Supabase Edge Functions
# ============================================================
# These are normally set as Supabase Edge Function secrets, not local pipeline
# variables. They are included here so contributors know what the edge functions need.
# Do not expose these in frontend/Lovable code.
WYSCOUT_CLIENT_ID=your_wyscout_client_id
WYSCOUT_CLIENT_SECRET=your_wyscout_client_secret
WYSCOUT_BASE_URL=https://apirest.wyscout.com/v3


# ============================================================
# 3. Team and analysis scope
# ============================================================
TEAM_QUERY=Jonkopings
TARGET_TEAM_KEYWORD=jonkopings sodra

# Keep outputs scoped to the active/current season.
FILTER_TO_ACTIVE_SEASON=1

# Analysis and form controls.
RECENT_MATCH_LIMIT=30
MAX_EVENT_MATCHES=12
NEXT_OPPONENT_EVENT_MATCHES=10
RECENT_FORM_MATCHES=5
UPCOMING_FIXTURE_LIMIT=5
MAX_H2H_MATCHES=8
ANALYSIS_EVENT_MATCH_TARGET=12
MAX_PREVIOUS_SEASON_MATCHES=12

# Previous-season behaviour.
ENABLE_PREVIOUS_SEASON_COMPLEMENT=0
H2H_FALLBACK_TO_PREVIOUS_SEASON=1


# ============================================================
# 4. Local output folders
# ============================================================
OUTPUT_DIR=.
REPORTS_DIR=reports


# ============================================================
# 5. Supabase Storage upload
# ============================================================
# Set this to 1 when generated reports should be uploaded to Supabase Storage.
UPLOAD_TO_SUPABASE_STORAGE=0

# Supabase Storage S3-compatible endpoint and bucket.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=your_bucket_name
SUPABASE_S3_ACCESS_KEY=your_s3_access_key
SUPABASE_S3_SECRET_KEY=your_s3_secret_key

# Optional prefix inside the bucket. Leave empty to upload directly under reports/.
SUPABASE_S3_PREFIX=

# Public Supabase project URL used to build public file URLs.
SUPABASE_PUBLIC_BASE_URL=https://<project-ref>.supabase.co


# ============================================================
# 6. Incremental event cache
# ============================================================
ENABLE_INCREMENTAL_EVENT_FETCH=1
EVENT_CACHE_DIR=cache/events
EVENT_CACHE_RECHECK_MISSING_HOURS=24


# ============================================================
# 7. Incremental competition cache
# ============================================================
ENABLE_INCREMENTAL_COMPETITION_FETCH=1
COMPETITION_CACHE_DIR=cache/competitions
COMPETITION_CACHE_TTL_HOURS=24


# ============================================================
# 7b. Incremental player cache
# ============================================================
ENABLE_INCREMENTAL_PLAYER_FETCH=1
PLAYER_CACHE_DIR=cache/players
PLAYER_CACHE_TTL_HOURS=24


# ============================================================
# 8. Force refresh behaviour
# ============================================================
# Usually leave this as 0 locally and use `python fetch_football_data.py --force-refresh`
# when you want to bypass caches for a single run.
FORCE_REFRESH_FROM_API=0


# ============================================================
# 9. Modular section controls
# ============================================================
# Optional comma-separated list of sections to run.
# Leave empty to run all sections registered in pipeline/registry.py.
# Examples:
#   ENABLED_SECTIONS=corners
#   ENABLED_SECTIONS=corners,head_to_head
ENABLED_SECTIONS=

# Development-only option. If set to 1, section failures are logged but do not
# stop the whole pipeline. Keep this at 0 in production/GitHub Actions.
ALLOW_SECTION_FAILURES=0


# ============================================================
# 10. Refresh-reports Edge Function -> GitHub Actions
# ============================================================
# These are Supabase Edge Function secrets for the refresh-reports function.
# They are included here for documentation. Prefer setting them with:
#   supabase secrets set KEY=value
GITHUB_OWNER=your_github_owner_or_org
GITHUB_REPO=your_repo_name
GITHUB_TOKEN=your_github_token_with_actions_permissions
GITHUB_REFRESH_WORKFLOW_FILE=refresh-reports.yml
GITHUB_REFRESH_REF=main
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REFRESH_EVENT=workflow_dispatch


# ============================================================
# 11. Sync-league Edge Function / warehouse sync
# ============================================================
# These are used by the sync-league Edge Function if the Supabase warehouse
# sync flow is enabled. They are normally Supabase Edge Function secrets.
SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SYNC_LEAGUE_TOKEN=choose_a_long_random_secret
